{
  "$schema": "https://opencode.ai/config.json",

  "model": "llama.cpp/qwen-local",

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",

      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-no-key-required"
      },

      "models": {
        "qwen-local": {
          "name": "Qwen local",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  }
}
