{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama.cpp/qwen-local",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local GGUF)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local-not-used"
      },
      "models": {
        "qwen-local": {
          "name": "Qwen Local GGUF via llama.cpp",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
