{
  "$schema": "https://opencode.ai/config.json",

  "model": "llama.cpp/qwen3.6-vision",

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",

      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },

      "models": {
        "qwen3.6-vision": {
          "name": "Qwen 3.6 Vision (local)",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen-local": {
          "name": "Qwen local",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
