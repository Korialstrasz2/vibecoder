{
  "$schema": "https://opencode.ai/config.json",

  "model": "llama.cpp/qwen36-vision",

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",

      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-no-key-required"
      },

      "models": {
        "qwen-local": {
          "name": "Qwen local",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },

        "qwen36-vision": {
          "name": "Qwen3.6-35B-A3B Vision",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}