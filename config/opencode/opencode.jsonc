{
  "$schema": "https://opencode.ai/config.json",

  "model": "llama.cpp/qwen3.6-vision",
  "default_agent": "loose",

  "agent": {
    "loose": {
      "mode": "primary",
      "description": "Less restricted mode with auto-approved actions and fewer guardrails",
      "prompt": "{file:./prompts/loose-prompt.txt}",
      "permission": {
        "*": "allow",
        "external_directory": "ask",
        "doom_loop": "ask"
      }
    }
  },

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",

      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },

      "models": {
        "qwen3.6-vision": {
          "name": "Qwen 3.6 Vision (local)",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen-local": {
          "name": "Qwen local",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
